            currentJobIndex = 0;
            update_move_speed_from_job(wander);
        }
    }
    // Execute movement
    bool moved = false;
    EntityJob& current = jobList[currentJobIndex];
    update_move_speed_from_job(jobList[currentJobIndex]);
