    jobList.erase(
        std::remove_if(jobList.begin(), jobList.end(),
            <a href="const EntityJob& j" target="_blank" rel="noopener noreferrer nofollow"></a> { return j.complete;}),
        jobList.end()
    );
    if (currentJobIndex >= jobList.size()) { currentJobIndex = -1; }
